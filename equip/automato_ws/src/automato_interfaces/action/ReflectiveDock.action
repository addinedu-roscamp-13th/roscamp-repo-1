# automato_interfaces/action/ReflectiveDock
#
# 시나리오1 E4 3-3(순찰 종료 복귀) / E2 22-1(작업 실패 복귀) : 충전소 반사테이프 정밀 후진 도킹
#   ACS -> DG    : /{robot_id}/reflective_dock
#   DG  -> DdaGo : /ddago/reflective_dock        (로봇 쪽은 네임스페이스를 붙이지 않는다)
#
# charuco(Dock)·H마커(FloorDock)와 나란한 세 번째 도킹 방식. 2D 라이다로 재귀반사테이프
# '코너 마커'(수직 두 면이 꼭짓점에서 직각으로 만남)를 검출해 후진으로 접붙인다.
# 카메라가 아니라 라이다라서 조명과 무관하고, 마커가 매우 가까워져도 검출이 유지된다.
#
# 도킹 기동: 멈춘 채 마커 법선을 스냅(SNAP) -> 법선 위로 사전정렬(TURN1/DRIVE/TURN2)
#            -> β(중앙)·법선이탈 교정하며 후진 접근(APPROACH) -> 마지막 블라인드 후진(CREEP).
# 라이다 0°축이 섀시 뒤를 향하므로 마커를 '뒤로' 보며 후진한다.
#
# charuco 와 달리 마커 규격 정보를 goal 로 넘기지 않는다: 3대 로봇·모든 충전소의 마커가
# 동일 규격(코너)이라 보드 파라미터가 필요 없다. 대상 스테이션 구분도 마커 ID 로 하지 않는다
# — Navigate 가 목표 앞(정면)에 세우고, 검출부가 '가장 정면인 마커'만 lock(공간 게이팅)한다.
# 로봇 물리값(라이다~뒤끝 rear_offset_m)은 로봇별 config yaml 에서 읽으므로 goal 이 아니다.
#
# 실패 재시도는 ACS 가 관장한다(N_dock 기본 3회). 초과 시 task_failed
# (reason=DOCK_FAILED, recovery_action=NONE) 알림 후 진입 노드에 정지한다.

# ---------- Goal ----------
int64   task_id
string  task_point_id      # 도킹 대상 작업 지점 (예: 'CHARGE_01') — 로깅·추적용

# 목표 정차(옵션). 0 이면 노드 파라미터(로봇 config yaml) 기본값을 쓴다.
float32 stop_gap_m         # 목표 뒤끝~마커 간격 [m] (0 → 노드 기본 stop_gap_m)
---
# ---------- Result ----------
int32   result_code        # 0: 성공, 1: 마커 미검출, 2: 정차 오차 초과, 3: 중단, 4: 정렬 실패
float32 final_gap_m        # 최종 뒤끝~마커 간격(추정) [m]

# 오차를 축별로 나눠 남긴다(후진 도킹 오차는 앞뒤=갭·좌우=법선이탈·스큐가 겹친다).
float32 final_lateral_m    # 좌우: 마커 법선축에서 벗어난 거리 [m] (= cross-track e)
float32 final_yaw_error    # 스큐: 마커 법선 대비 최종 틀어짐 [rad] (= tilt)

string  message
---
# ---------- Feedback ----------
string  phase              # SNAP / TURN1 / DRIVE / TURN2 / APPROACH / CREEP
bool    marker_detected
float32 distance_to_marker_m   # 라이다~마커 꼭짓점 거리 [m]
